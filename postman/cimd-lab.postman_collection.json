{
  "info": {
    "name": "CIMD LAB",
    "description": "API collection for CIMD LAB: drive the lab's teaching authorization server (Direction 2), probe real PingFederate (Direction 1), and exercise the H2 2026 gateway simulation (mock only). Pair with <slug>.live.environment.json filled by shared/postman/fill-env.mjs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-cimd-lab"
  },
  "item": [
    {
      "name": "Sanity",
      "description": "Lab liveness and configuration as the server sees it.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "const b = pm.response.json(); pm.expect(b.state).to.be.oneOf(['ready', 'needs-setup']);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{LAB_BASE}}/api/health",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
