        {
          "name": "Validate a pasted document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Assertions for this request */",
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json()).to.have.property('valid');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": {\n    \"client_id\": \"https://client.example/client.json\",\n    \"redirect_uris\": [\n      \"https://client.example/callback\"\n    ],\n    \"token_endpoint_auth_method\": \"none\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/validate",
              "host": [
                "{{LAB_BASE}}"
