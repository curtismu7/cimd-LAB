{
  "name": "cimd-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "test": "npm test -w server && npm test -w web",
    "start": "node --env-file=.env server/src/index.js",
    "build": "npm run build -w web",
    "dev:web": "npm run dev -w web",
    "doctor": "node scripts/doctor.mjs",
    "mock-table": "node scripts/build-mock-table.mjs",
    "talk-track": "node scripts/build-talk-track.mjs",
    "content-pack": "node scripts/validate-content-pack.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
